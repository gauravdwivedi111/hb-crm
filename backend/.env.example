# ==============================================================================
# HB CRM — Backend Production Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the server.
# Every variable listed below is required in production unless explicitly noted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' on live hosts (Railway, Render, AWS, Heroku, etc.).
# When set to 'production', this automatically enables:
#   - Strict cookie security (Secure=true)
#   - Sanitized error responses (stack traces and internal errors stripped)
#   - Mandatory verification of S3 credentials at startup
#   - Minimal Prisma error-only logging
NODE_ENV=production

# The port Express will listen on. Most cloud hosts (Railway, Render) set PORT
# automatically. In local production Docker, default is 5001.
PORT=5001

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection string.
# Production requirements:
#   - Use a dedicated connection pooler (e.g. Supabase, PgBouncer, Neon, RDS).
#   - Append '?sslmode=require' for encrypted cloud database connections.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:your_secure_db_password@db.yourhost.com:5432/hbcrm?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 3. CORS & CROSS-ORIGIN ACCESS
# ------------------------------------------------------------------------------
# The exact origin(s) of your frontend web application.
# Used by Express CORS middleware to restrict access and allow credentials (cookies).
# In production, specify the HTTPS domain where the React app is hosted.
# If you have multiple domains (e.g. custom domain and staging URL), separate with commas.
# Do NOT include trailing slashes.
FRONTEND_URL="https://app.yourclient.com"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECRETS
# ------------------------------------------------------------------------------
# MANDATORY: A cryptographically strong, random string (min 32 characters).
# The backend will immediately throw a fatal error and exit at startup if missing.
# Generate a secure 64-character secret using: openssl rand -hex 32
JWT_ACCESS_SECRET="generate_a_secure_random_64_char_hex_secret_here"

# Lifespan of the stateless access token (e.g. '15m', '30m').
JWT_ACCESS_EXPIRES_IN="15m"

# Lifespan of the rotating refresh token stored in the database and HTTP-only cookie.
REFRESH_TOKEN_EXPIRES_DAYS=7

# Cookie SameSite policy:
#   - 'none': REQUIRED if frontend and backend are on different domains (e.g. app.com & api.com, or Vercel & Railway).
#   - 'lax': Use if frontend and backend are on the exact same domain / reverse-proxied.
COOKIE_SAME_SITE="none"

# ------------------------------------------------------------------------------
# 5. INITIAL ADMINISTRATOR SEEDING
# ------------------------------------------------------------------------------
# Credentials used ONLY when running the initial database seed script:
#   npm run seed (or npx prisma db seed)
# This provisions the very first Admin account needed to log into the CRM.
SEED_ADMIN_EMAIL="admin@yourclient.com"
SEED_ADMIN_PASSWORD="ChooseAStrongInitialPassword123!"
SEED_ADMIN_NAME="System Administrator"

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (AWS S3 or Cloudflare R2)
# ------------------------------------------------------------------------------
# Required in production for secure customer enquiry file attachments.
# The server verifies these exist at startup when NODE_ENV=production.

# Name of your bucket (must already exist in AWS S3 or Cloudflare R2)
S3_BUCKET_NAME="hb-crm-attachments-production"

# For Cloudflare R2: use 'auto'. For AWS S3: use your bucket region (e.g. 'ap-south-1', 'us-east-1').
S3_REGION="auto"

# For Cloudflare R2: https://<cloudflare_account_id>.r2.cloudflarestorage.com
# For AWS S3: Leave blank or comment out (uses standard AWS regional endpoints).
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# Storage API credentials with PutObject, GetObject, and DeleteObject permissions on the bucket.
S3_ACCESS_KEY_ID="your_s3_or_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_s3_or_r2_secret_access_key"

# ------------------------------------------------------------------------------
# 7. BUSINESS TIMEZONE
# ------------------------------------------------------------------------------
# IANA Timezone string used by the CRM backend to compute local business day boundaries
# for follow-ups due today, monthly reports, and midnight calendar rollovers.
# Default is 'Asia/Kolkata' (IST). Change only if your client operates in another zone.
TIMEZONE="Asia/Kolkata"

# ------------------------------------------------------------------------------
# 8. EMAIL DELIVERY (Resend)
# ------------------------------------------------------------------------------
# Required in production for high-signal email alerts (FOLLOWUP_OVERDUE, ENQUIRY_ASSIGNED).
# In development (NODE_ENV !== 'production'), if RESEND_API_KEY is omitted,
# emails are safely logged to console output without failing.
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM_ADDRESS="HB CRM <notifications@yourcompany.com>"

