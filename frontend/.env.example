# ==============================================================================
# HB CRM — Frontend Production Environment Configuration
# ==============================================================================
# In Vite, variables exposed to the client-side bundle MUST start with 'VITE_'.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND API BASE URL
# ------------------------------------------------------------------------------
# The fully-qualified HTTPS origin and path of the backend API server.
#
# Examples:
#   Custom domain:      https://api.yourclient.com
#   Railway backend:    https://backend-production-xxxx.up.railway.app
#   Render backend:     https://hb-crm-backend.onrender.com
#   Local development:  http://localhost:5001
#
# IMPORTANT:
#   - Must start with 'https://' in production.
#   - Do NOT include a trailing slash.
#   - The frontend API wrapper automatically appends endpoint paths (e.g. '/auth/login').
#
VITE_API_URL="https://api.yourclient.com"
